# ── Base de données ───────────────────────────────────────────
DATABASE_URL="postgresql://lakol:lakol@localhost:5432/lakol?schema=public"

# ── Redis (file de tâches, à partir de la phase 3) ────────────
REDIS_URL="redis://localhost:6379"

# ── Application ───────────────────────────────────────────────
# URL publique (liens dans les messages WhatsApp / emails)
APP_URL="http://localhost:3000"
# "production" sur le serveur : configuration vérifiée au démarrage (voir DEPLOIEMENT.md)
DEPLOY_ENV=""
# Domaine principal : ecole-x.<ROOT_DOMAIN> ouvre l'espace de l'école (vide : désactivé)
ROOT_DOMAIN=""

# ── WhatsApp Business ─────────────────────────────────────────
# "mock" (défaut) écrit les messages dans les logs ; "meta" utilise l'API Cloud.
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Modèle approuvé par Meta (obligatoire pour écrire en premier) et ses langues
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGES="fr"
# Webhook des statuts (envoyé, remis, lu) : https://votre-domaine/api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ── Email ─────────────────────────────────────────────────────
# "mock" (défaut) écrit les emails dans les logs ; "resend" utilise Resend.
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
EMAIL_FROM="LAKOL <no-reply@exemple.com>"

# ── Stockage de fichiers ──────────────────────────────────────
# "local" (défaut) : fichiers dans STORAGE_DIR ; "s3" : stockage compatible S3.
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="lakol"
S3_ACCESS_KEY_ID="lakol"
S3_SECRET_ACCESS_KEY="lakol-secret"
