# Configuration de production (copier en .env.production, ne jamais committer).
# Les variables marquées « requis » sont vérifiées au démarrage (DEPLOY_ENV=production).

# ── Images (facultatif) ──────────────────────────────────────
# Vide : images construites sur le serveur. Sinon, images publiées par la CI (GHCR) :
# LAKOL_REGISTRY="ghcr.io/abdoussamadagalhousseini/"
# LAKOL_VERSION="v1.0.0"

# ── Domaine et certificats ───────────────────────────────────
ROOT_DOMAIN="lakol.ml"                    # requis : domaine principal (DNS A + *.lakol.ml vers le serveur)
APP_URL="https://lakol.ml"                # requis : https
ACME_EMAIL="ops@lakol.ml"                 # requis : contact Let's Encrypt

# ── Base de données ──────────────────────────────────────────
POSTGRES_PASSWORD=""                      # requis : long mot de passe aléatoire (openssl rand -hex 24)

# ── Premier super admin (créé par platform:init s'il n'existe pas) ──
ADMIN_EMAIL="ops@lakol.ml"
ADMIN_PASSWORD=""                         # 12 caractères au moins ; à changer après la première connexion
ADMIN_FIRST_NAME="Équipe"
ADMIN_LAST_NAME="LAKOL"

# ── WhatsApp Business (Meta Cloud API) ───────────────────────
WHATSAPP_PROVIDER="meta"
WHATSAPP_PHONE_NUMBER_ID=""               # requis
WHATSAPP_ACCESS_TOKEN=""                  # requis : jeton permanent (utilisateur système)
WHATSAPP_TEMPLATE_NAME="lakol_notification"   # requis : modèle approuvé (voir DEPLOIEMENT.md)
WHATSAPP_TEMPLATE_LANGUAGES="fr,en"       # langues dans lesquelles le modèle est approuvé
WHATSAPP_VERIFY_TOKEN=""                  # requis : chaîne aléatoire, à recopier dans Meta
WHATSAPP_APP_SECRET=""                    # requis : clé secrète de l'application Meta

# ── Email (Resend) ───────────────────────────────────────────
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""                         # requis
EMAIL_FROM="LAKOL <no-reply@lakol.ml>"    # requis : domaine vérifié chez Resend

# ── Fichiers ─────────────────────────────────────────────────
# "local" : volume Docker « storage » (sauvegardé chaque nuit). "s3" : Cloudflare R2 ou équivalent.
STORAGE_PROVIDER="local"
# S3_ENDPOINT="https://<compte>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="lakol-files"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Sauvegardes ──────────────────────────────────────────────
BACKUP_HOUR="2"                           # heure UTC de la sauvegarde quotidienne
BACKUP_KEEP_DAILY="30"
BACKUP_KEEP_MONTHLY="12"
# Copie hors serveur (fortement recommandé) :
# BACKUP_S3_URI="s3://lakol-backups"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_ENDPOINT_URL="https://<compte>.r2.cloudflarestorage.com"
