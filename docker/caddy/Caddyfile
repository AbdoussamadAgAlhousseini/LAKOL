# Proxy HTTPS de LAKOL : certificats Let's Encrypt automatiques.
# Les sous-domaines d'écoles (ecole-x.domaine) reçoivent leur certificat à la
# première visite, après accord de l'application (/api/tls-check).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/tls-check
	}
}

(lakol) {
	encode zstd gzip
	# Le flux temps réel (SSE) est transmis sans tampon : Caddy le détecte seul.
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
	log {
		output stdout
		format json
	}
}

{$ROOT_DOMAIN} {
	import lakol
}

www.{$ROOT_DOMAIN} {
	redir https://{$ROOT_DOMAIN}{uri} permanent
}

# Sous-domaines des écoles.
https:// {
	tls {
		on_demand
	}
	import lakol
}
